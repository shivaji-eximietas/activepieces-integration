{
  "root": true,
  "parser": "@typescript-eslint/eslint-plugin",
  "parserOptions": {
    "project": ["tsconfig.app.json"]
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**"]
}
