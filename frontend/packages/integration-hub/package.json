{
  "name": "integration-hub",
  "version": "0.0.1",
  "private": true,
  "description": "Standalone frontend for integration-hub. Copy this folder anywhere and run `npm install && npm run dev`.",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm run dev",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@tanstack/react-query": "5.80.7",
    "axios": "1.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "postcss": "8.5.4",
    "tailwindcss": "3.4.17",
    "tsx": "4.21.0",
    "typescript": "5.5.4",
    "vite": "6.3.5"
  }
}
